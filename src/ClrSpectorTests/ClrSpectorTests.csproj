<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- TUnit runs on Microsoft.Testing.Platform, so the test project is an executable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Tiered compilation rewrites the same precode dispatch slot that MethodDetour patches,
      which would silently drop a redirect mid-test. Turn it off so entry points are stable.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.65.68" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClrSpector\ClrSpector.csproj" />
  </ItemGroup>

</Project>
